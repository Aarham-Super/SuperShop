@model IReadOnlyList<SuperShop.Models.WishlistItem>
@{ ViewData["Title"] = "My Wishlist"; }
<div class="shop-container">
    <div class="page-header"><h1 class="page-title">My Wishlist</h1><p class="page-subtitle">Products you saved for later.</p></div>
    @if (TempData["SuccessMessage"] != null) { <div class="admin-alert admin-alert-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="admin-alert admin-alert-danger">@TempData["ErrorMessage"]</div> }
    @if (Model.Count == 0)
    {
        <div class="ss-card text-center"><h2>Your wishlist is empty</h2><p class="text-muted-custom">Save products you would like to come back to.</p><a asp-controller="Products" asp-action="Index" class="ss-btn ss-btn-primary">Browse Products</a></div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var item in Model)
            {
                var product = item.Product!;
                var image = product.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.DisplayOrder).FirstOrDefault();
                <article class="product-card">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                        @if (image != null) { <img class="product-card-image" src="@image.ImageUrl" alt="@(image.AltText ?? product.Name)" /> }
                        else { <div class="product-card-image d-flex align-items-center justify-content-center">📦</div> }
                    </a>
                    <div class="product-card-body"><div class="product-category">@product.Category?.Name</div><h2 class="product-name"><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h2><p class="product-price">@((product.SalePrice ?? product.Price).ToString("C"))</p>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="ss-btn ss-btn-primary">View product</a>
                        <form asp-action="Remove" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="ss-btn ss-btn-secondary" type="submit">Remove</button></form>
                    </div>
                </article>
            }
        </div>
    }
</div>
