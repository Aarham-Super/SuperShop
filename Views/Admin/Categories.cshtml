@model IEnumerable<Category>

@{
    ViewData["Title"] = "Category Management";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h1>Category Management</h1>
            <p>Create and manage the categories used throughout SuperShop.</p>
        </div>

        <div>
            <button type="button"
                    class="ss-btn ss-btn-primary"
                    onclick="document.getElementById('addCategoryPanel').scrollIntoView({ behavior: 'smooth' });">
                + Add Category
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card" id="addCategoryPanel">

        <div class="admin-card-header">
            <div>
                <h2>Add New Category</h2>
                <p>Create a category for your product catalogue.</p>
            </div>
        </div>

        <form asp-action="AddCategory"
              method="post"
              class="admin-category-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="admin-alert admin-alert-danger">
            </div>

            <div class="admin-form-row admin-category-form-row">

                <div class="admin-form-field">

                    <label for="Name">
                        Category name
                    </label>

                    <input type="text"
                           id="Name"
                           name="Name"
                           class="admin-form-control"
                           maxlength="100"
                           required
                           placeholder="e.g. Electronics" />

                </div>

                <div class="admin-form-field">

                    <label for="DisplayOrder">
                        Display order
                    </label>

                    <input type="number"
                           id="DisplayOrder"
                           name="DisplayOrder"
                           class="admin-form-control"
                           min="0"
                           value="0" />

                </div>

            </div>

            <div class="admin-form-field">

                <label for="Description">
                    Description
                </label>

                <textarea id="Description"
                          name="Description"
                          class="admin-form-control"
                          rows="3"
                          maxlength="500"
                          placeholder="Optional category description"></textarea>

            </div>

            <div class="admin-checkbox-group">

                <label class="admin-checkbox">

                    <input type="checkbox"
                           name="IsActive"
                           value="true"
                           checked />

                    <span>
                        <strong>Active category</strong>
                        <small>
                            Customers can see products from this category.
                        </small>
                    </span>

                </label>

            </div>

            <div class="admin-form-actions">

                <button type="submit"
                        class="ss-btn ss-btn-primary">
                    Save Category
                </button>

            </div>

        </form>

    </div>

    <div class="admin-card admin-category-list-card">

        <div class="admin-card-header">

            <div>
                <h2>Categories</h2>

                <span class="admin-muted">
                    @Model.Count() categor@(Model.Count() == 1 ? "y" : "ies")
                </span>
            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="admin-empty-state">

                <div class="admin-empty-icon">
                    🗂️
                </div>

                <h3>No categories yet</h3>

                <p>
                    Create your first category above.
                    Categories are required when adding products.
                </p>

            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>

                        <tr>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Products</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var category in Model)
                        {
                            var productCount = category.Products?.Count ?? 0;

                            <tr>

                                <td>
                                    <strong>
                                        @category.Name
                                    </strong>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <span class="admin-muted">
                                            No description
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @category.Description
                                        </span>
                                    }
                                </td>

                                <td>
                                    <strong>
                                        @productCount
                                    </strong>
                                </td>

                                <td>
                                    @category.DisplayOrder
                                </td>

                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="admin-badge admin-badge-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>
                                    @category.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <form asp-action="ToggleCategory"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@category.Id" />

                                            <button type="submit"
                                                    class="ss-btn ss-btn-secondary ss-btn-small">

                                                @(category.IsActive
                                                    ? "Deactivate"
                                                    : "Activate")

                                            </button>

                                        </form>

                                        @if (productCount == 0)
                                        {
                                            <form asp-action="DeleteCategory"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this category?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@category.Id" />

                                                <button type="submit"
                                                        class="ss-btn ss-btn-danger ss-btn-small">
                                                    Delete
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}