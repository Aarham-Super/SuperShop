@model IReadOnlyList<SuperShop.ViewModels.AdminCustomerRowViewModel>
@{ ViewData["Title"] = "Customers"; }
<div class="shop-container">
    <div class="page-header"><h1 class="page-title">Customers</h1><p class="page-subtitle">Registered customer accounts and their demo activity.</p></div>
    @if (Model.Count == 0) { <div class="ss-card"><h2>No customer accounts yet</h2></div> }
    else
    {
        <div class="ss-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Email status</th><th>Demo orders</th><th>Demo spend</th></tr></thead><tbody>
        @foreach (var customer in Model)
        {
            <tr><td>@(customer.User.FullName ?? "—")</td><td>@customer.User.UserName</td><td>@customer.User.Email</td><td>@(customer.User.EmailConfirmed ? "Confirmed" : "Unconfirmed")</td><td>@customer.OrderCount</td><td>@customer.DemoSpend.ToString("C")</td></tr>
        }
        </tbody></table></div></div>
    }
    <div class="mt-4"><a asp-action="Index" class="ss-btn ss-btn-secondary">← Back to Dashboard</a></div>
</div>
