@{
ViewData["Title"] = "Inventory";
}

<div class="shop-container">

<div class="page-header">

    <h1 class="page-title">
        Inventory
    </h1>

    <p class="page-subtitle">
        Monitor product stock and inventory levels.
    </p>

</div>

<div class="admin-test-notice">

    <strong>
        TEST / DEMONSTRATION SHOP
    </strong>

    <p>
        Inventory information will be connected to the
        product catalogue and database.
    </p>

</div>

<div class="admin-stats-grid">

    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            📦
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Total Items
            </span>

            <strong class="admin-stat-value">
                0
            </strong>

        </div>

    </div>

    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            ⚠️
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Low Stock
            </span>

            <strong class="admin-stat-value">
                0
            </strong>

        </div>

    </div>

    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            ❌
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                Out of Stock
            </span>

            <strong class="admin-stat-value">
                0
            </strong>

        </div>

    </div>

    <div class="admin-stat-card">

        <div class="admin-stat-icon">
            ✅
        </div>

        <div class="admin-stat-content">

            <span class="admin-stat-label">
                In Stock
            </span>

            <strong class="admin-stat-value">
                0
            </strong>

        </div>

    </div>

</div>

<div class="admin-section">

    <div class="ss-card">

        <h2>
            Inventory Management
        </h2>

        <div class="text-center py-5">

            <div style="font-size: 3rem;">
                📦
            </div>

            <h3 class="mt-3">
                No Inventory Data
            </h3>

            <p class="text-muted-custom">
                Inventory will appear here after products
                are added to the catalogue.
            </p>

        </div>

    </div>

</div>

<div class="mt-4 mb-5">

    <a asp-controller="Admin"
       asp-action="Index"
       class="ss-btn ss-btn-secondary">
        ← Back to Dashboard
    </a>

</div>

</div>