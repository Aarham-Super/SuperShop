@model SuperShop.ViewModels.CartPageViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="shop-container">
    <div class="page-header">
        <h1 class="page-title">Shopping Cart</h1>
        <p class="page-subtitle">Review the products you added to your cart.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Items.Any())
    {
        <div class="empty-cart">
            <div class="empty-cart-icon" aria-hidden="true">🛒</div>
            <h2>Your cart is empty</h2>
            <p class="text-muted-custom">Browse the shop and add something you like.</p>
            <a asp-controller="Products" asp-action="Index" class="ss-btn ss-btn-primary">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <article class="cart-item">
                        @if (item.Image != null)
                        {
                            <img src="@item.Image.ImageUrl" alt="@(item.Image.AltText ?? item.Product.Name)" class="cart-item-image" />
                        }
                        else
                        {
                            <div class="cart-item-image d-flex align-items-center justify-content-center" aria-hidden="true">📦</div>
                        }
                        <div class="cart-item-content">
                            <h2 class="cart-item-name">@item.Product.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(item.Size)) { <p>Size: @item.Size</p> }
                            <p class="cart-item-price">@item.UnitPrice.ToString("C") each · Quantity: @item.Quantity</p>
                        </div>
                        <strong>@item.LineTotal.ToString("C")</strong>
                        <form asp-action="Remove" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.Product.Id" />
                            <input type="hidden" name="size" value="@item.Size" />
                            <button type="submit" class="ss-btn ss-btn-secondary ss-btn-small">Remove</button>
                        </form>
                    </article>
                }
            </div>
            <aside class="col-lg-4">
                <div class="cart-summary">
                    <h2>Cart total</h2>
                    <div class="cart-summary-row"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div>
                    @if (Model.PromotionPercent > 0)
                    {
                        <div class="cart-summary-row"><span>@Model.PromotionCode (@Model.PromotionPercent% off)</span><strong>-@Model.DiscountAmount.ToString("C")</strong></div>
                    }
                    <div class="cart-summary-total"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div>
                    @if (Model.PromotionPercent > 0)
                    {
                        <form asp-action="RemovePromotion" method="post" class="mt-2">@Html.AntiForgeryToken()<button class="ss-btn ss-btn-secondary w-100" type="submit">Remove promotion</button></form>
                    }
                    else
                    {
                        <form asp-action="ApplyPromotion" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <label for="promoCode" class="form-label">Promotion code</label>
                            <input id="promoCode" name="code" class="ss-form-control" maxlength="32" autocomplete="off" placeholder="Enter code" required />
                            <button type="submit" class="ss-btn ss-btn-secondary w-100 mt-2">Apply code</button>
                        </form>
                    }
                    <a asp-action="Checkout" class="ss-btn ss-btn-primary w-100 mt-3">Proceed to Checkout</a>
                    <a asp-controller="Products" asp-action="Index" class="ss-btn ss-btn-secondary w-100 mt-2">Continue Shopping</a>
                    <form asp-action="Clear" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ss-btn ss-btn-secondary w-100">Clear Cart</button>
                    </form>
                    <p class="text-muted-custom mt-3">Demo purchase only. No payment is processed.</p>
                </div>
            </aside>
        </div>
    }
</div>

