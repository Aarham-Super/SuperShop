@{
    ViewData["Title"] = "Shipping & Returns";
}
<div class="shop-container">
    <div class="page-header"><h1 class="page-title">Shipping & Returns</h1><p class="page-subtitle">Information for the SuperShop demonstration store.</p></div>
    <div class="ss-card mb-4"><h2>Shipping</h2><p>This demo site does not dispatch products. Orders are simulations for testing the shop experience; no shipping address or delivery fee is collected.</p></div>
    <div class="ss-card mb-4"><h2>Returns</h2><p>Because demo orders are not real purchases and nothing is shipped, no real return or refund can be requested through this site.</p></div>
    <div class="ss-card"><h2>Need help?</h2><p>Contact the SuperShop site administrator through the channel they provided to you. This demonstration site does not have a customer support service.</p></div>
</div>
