@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <div class="privacy-container">

        <div class="privacy-header">

            <h1>Privacy Policy</h1>

            <p class="privacy-updated">
                Last updated: 6 October 2026
            </p>

            <p>
                At SuperShop, we respect your privacy and are committed
                to handling information responsibly. This Privacy Policy
                explains what information may be collected when you use
                this website and how that information is used.
            </p>

        </div>


        <div class="privacy-content">

            <section class="privacy-section">

                <h2>1. About SuperShop</h2>

                <p>
                    SuperShop is a practice and demonstration e-commerce
                    website created to demonstrate modern web development,
                    online shopping functionality, account management,
                    and product management.
                </p>

                <p>
                    This website is not intended to operate as a real
                    commercial payment platform.
                </p>

            </section>


            <section class="privacy-section">

                <h2>2. Information We May Collect</h2>

                <p>
                    Depending on how you use SuperShop, the website may
                    collect information that you voluntarily provide.
                </p>

                <ul>

                    <li>
                        Name or display name
                    </li>

                    <li>
                        Username
                    </li>

                    <li>
                        Email address
                    </li>

                    <li>
                        Account login information
                    </li>

                    <li>
                        Product, cart and wishlist information
                    </li>

                    <li>
                        Order information generated during testing
                    </li>

                </ul>

            </section>


            <section class="privacy-section">

                <h2>3. Account Information</h2>

                <p>
                    If you create an account, information such as your
                    username, email address and name may be stored in the
                    SuperShop database so that the website can provide
                    account-related functionality.
                </p>

                <p>
                    Passwords are handled through ASP.NET Core Identity
                    and are not intended to be stored as plain text.
                </p>

            </section>


            <section class="privacy-section">

                <h2>4. Shopping Information</h2>

                <p>
                    When using the shopping functionality, SuperShop may
                    store information associated with your shopping
                    activity, including products added to your cart,
                    wishlist information and test orders.
                </p>

                <p>
                    This information is used to demonstrate normal
                    e-commerce functionality.
                </p>

            </section>


            <section class="privacy-section">

                <h2>5. Payments and Card Information</h2>

                <p>
                    SuperShop has no payment system or card-entry form.
                    Payments are not processed, and no card information is
                    requested or collected by this website.
                </p>

                <div class="privacy-notice">

                    <strong>
                        DO NOT ENTER PAYMENT CARD DETAILS
                    </strong>

                    <p>
                        No real or simulated payment is processed through
                        this website.
                    </p>

                </div>

                <p>
                    Because there is no card-entry form, card numbers,
                    security codes and expiry dates are not sent to or stored
                    by SuperShop or saved by this website in your browser.
                </p>

            </section>


            <section class="privacy-section">

                <h2>6. How Information Is Used</h2>

                <p>
                    Information may be used to:
                </p>

                <ul>

                    <li>
                        Create and manage user accounts
                    </li>

                    <li>
                        Provide shopping functionality
                    </li>

                    <li>
                        Process simulated test orders
                    </li>

                    <li>
                        Display order history
                    </li>

                    <li>
                        Maintain website functionality
                    </li>

                    <li>
                        Demonstrate e-commerce features
                    </li>

                </ul>

            </section>


            <section class="privacy-section">

                <h2>7. Cookies and Authentication</h2>

                <p>
                    SuperShop may use cookies required for authentication,
                    session management and normal website functionality.
                </p>

                <p>
                    Authentication cookies allow the website to remember
                    that a user has successfully signed in while they
                    navigate through the website.
                </p>

            </section>


            <section class="privacy-section">

                <h2>8. Website Security</h2>

                <p>
                    SuperShop uses server-side authentication and
                    authorization mechanisms to protect restricted
                    functionality.
                </p>

                <p>
                    Administrative functionality is restricted to
                    authorized SuperAdmin accounts and is not available
                    to ordinary customers.
                </p>

            </section>


            <section class="privacy-section">

                <h2>9. Information Sharing</h2>

                <p>
                    Information collected through this demonstration
                    website is not intended to be sold or shared for
                    advertising purposes.
                </p>

                <p>
                    Information may be accessed by authorized administrators
                    where necessary to operate and demonstrate the website.
                </p>

            </section>


            <section class="privacy-section">

                <h2>10. Data Retention</h2>

                <p>
                    Account, product and test-order information may remain
                    in the database for as long as necessary to operate,
                    test and demonstrate the SuperShop application.
                </p>

                <p>
                    Because this is a demonstration and practice application,
                    test information should not be considered a permanent
                    commercial transaction record.
                </p>

            </section>


            <section class="privacy-section">

                <h2>11. Third-Party Services</h2>

                <p>
                    SuperShop may be hosted using third-party infrastructure
                    or services. Those services may process technical
                    information required to deliver the website.
                </p>

                <p>
                    Third-party services may have their own privacy policies
                    and terms that apply to their services.
                </p>

            </section>


            <section class="privacy-section">

                <h2>12. Children's Privacy</h2>

                <p>
                    SuperShop is not specifically designed to collect
                    personal information from children.
                </p>

                <p>
                    Users should not provide personal information belonging
                    to another person without appropriate authorization.
                </p>

            </section>


            <section class="privacy-section">

                <h2>13. Your Information</h2>

                <p>
                    If you have an account, you may contact the website
                    administrator regarding information associated with
                    your account.
                </p>

                <p>
                    Requests may include questions about account information,
                    correction of information or removal of test data,
                    subject to the technical capabilities and requirements
                    of the application.
                </p>

            </section>


            <section class="privacy-section">

                <h2>14. Changes to This Privacy Policy</h2>

                <p>
                    This Privacy Policy may be updated from time to time
                    as SuperShop functionality changes.
                </p>

                <p>
                    When changes are made, the updated version will be
                    published on this page.
                </p>

            </section>


            <section class="privacy-section">

                <h2>15. Contact</h2>

                <p>
                    If you have a question about this Privacy Policy or
                    the handling of information within SuperShop, please
                    contact the website administrator.
                </p>

            </section>


            <div class="privacy-footer-note">

                <strong>
                    SuperShop
                </strong>

                <p>
                    Practice and demonstration e-commerce application.
                </p>

            </div>

        </div>

    </div>

</div>
