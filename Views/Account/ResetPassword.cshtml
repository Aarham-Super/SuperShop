@model SuperShop.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }
<div class="shop-container"><div class="account-page"><div class="account-card">
    <div class="account-header"><h1>Reset your password</h1><p>Enter the email and six-digit code from your reset email.</p></div>
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="form-group"><label asp-for="Code" class="form-label">Six-digit code</label><input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /><span asp-validation-for="Code" class="text-danger"></span></div>
        <div class="form-group"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
        <div class="form-group"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button type="submit" class="ss-btn ss-btn-primary account-submit">Reset password</button>
    </form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
