@{ ViewData["Title"] = "Check Your Email"; }
<div class="shop-container"><div class="account-page"><div class="account-card">
    <div class="account-header"><h1>Check your email</h1><p>If an account matches that address and email delivery is available, a six-digit code will arrive shortly. The code expires in 10 minutes and can be used once.</p></div>
    <a asp-action="ResetPassword" class="ss-btn ss-btn-primary account-submit">Enter reset code</a>
    <div class="account-footer"><a asp-action="ForgotPassword">Request another code</a></div>
</div></div></div>
