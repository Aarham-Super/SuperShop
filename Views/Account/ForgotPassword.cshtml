@model SuperShop.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; }
<div class="shop-container"><div class="account-page"><div class="account-card">
    <div class="account-header"><h1>Forgot password?</h1><p>We’ll send a one-time six-digit code to the email on your account.</p></div>
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <button type="submit" class="ss-btn ss-btn-primary account-submit">Send code</button>
    </form>
    <div class="account-footer"><a asp-action="Login">Back to login</a></div>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
