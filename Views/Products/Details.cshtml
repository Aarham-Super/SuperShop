@model SuperShop.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var image = Model.Images
        .OrderByDescending(i => i.IsPrimary)
        .ThenBy(i => i.DisplayOrder)
        .FirstOrDefault();
}

<div class="shop-container">
    <div class="page-header">
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">@Model.Category?.Name</p>
    </div>

    @if (TempData["ErrorMessage"] != null) { <div class="admin-alert admin-alert-danger" role="alert">@TempData["ErrorMessage"]</div> }
    <div class="row g-4 align-items-start">
        <div class="col-md-6">
            @if (image != null) { <img class="product-details-image" src="@image.ImageUrl" alt="@(image.AltText ?? Model.Name)" /> }
            else { <div class="ss-card text-center py-5" aria-label="No product image available">Package</div> }
        </div>
        <div class="col-md-6">
            <h2 class="product-details-title">@Model.Name</h2>
            @if (Model.SalePrice.HasValue) { <p class="product-price"><span class="original-price">@Model.Price.ToString("C")</span> <span class="discount-price">@Model.SalePrice.Value.ToString("C")</span></p> }
            else { <p class="product-price">@Model.Price.ToString("C")</p> }
            @if (Model.Colors.Any()) { <p><strong>Colors:</strong> @string.Join(", ", Model.Colors.Select(color => color.Name))</p> }
            @if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="product-details-description">@Model.Description</p> }
            else if (!string.IsNullOrWhiteSpace(Model.ShortDescription)) { <p class="product-details-description">@Model.ShortDescription</p> }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Wishlist" asp-action="Add" method="post" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" /><button type="submit" class="ss-btn ss-btn-secondary">♡ Save to Wishlist</button></form>
            }
            @if (Model.Inventory?.StockQuantity > 0)
            {
                <p class="text-muted-custom">In stock · @Model.Inventory.StockQuantity available</p>
                <form asp-controller="Cart" asp-action="Add" method="post" class="product-purchase-form">
                    @Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" />
                    @if (Model.Sizes.Any())
                    {
                        <label for="productSize" class="form-label">Size</label>
                        <select id="productSize" name="size" class="ss-form-control" required><option value="">Choose a size...</option>@foreach (var size in Model.Sizes.OrderBy(s => s.Name)) { <option value="@size.Name">@size.Name</option> }</select>
                    }
                    <label for="productQuantity" class="form-label">Quantity</label>
                    <div class="cart-quantity" data-quantity-control><button type="button" data-quantity-decrease aria-label="Remove one">−</button><input id="productQuantity" type="number" name="quantity" value="1" min="1" max="@Model.Inventory.StockQuantity" required aria-label="Quantity" /><button type="button" data-quantity-increase aria-label="Add one">+</button></div>
                    <button type="submit" class="ss-btn ss-btn-primary mt-3">Add to Cart</button>
                </form>
            }
            else { <p class="text-muted-custom">Currently out of stock</p><button type="button" class="ss-btn ss-btn-primary" disabled>Out of Stock</button> }
            <p class="text-muted-custom mt-3">Demo shop only. No real payments are processed.</p>
            <p><a asp-controller="Home" asp-action="Shipping">Shipping &amp; Returns</a></p>
            <a asp-action="Index" class="ss-btn ss-btn-secondary">Back to Shop</a>
        </div>
    </div>

    <section class="mt-5 mb-5" aria-labelledby="reviews-heading">
        <h2 id="reviews-heading">Customer reviews</h2>
        @if (TempData["SuccessMessage"] != null) { <div class="admin-alert admin-alert-success">@TempData["SuccessMessage"]</div> }
        @if (Model.Reviews.Count == 0) { <p class="text-muted-custom">No approved reviews yet.</p> }
        else
        {
            @foreach (var review in Model.Reviews.OrderByDescending(review => review.CreatedAt))
            {
                <article class="ss-card mb-3"><div>@review.Rating / 5</div>
                    @if (!string.IsNullOrWhiteSpace(review.Title)) { <h3>@review.Title</h3> }
                    <p>@review.Comment</p><small class="text-muted-custom">@review.ReviewerName · @review.CreatedAt.ToLocalTime().ToString("d")</small>
                </article>
            }
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ss-card mt-4"><h3>Write a review</h3><p class="text-muted-custom">Reviews appear publicly after admin approval.</p>
                <form asp-controller="Reviews" asp-action="Create" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" />
                    <div class="admin-form-field"><label for="reviewRating">Rating</label><select id="reviewRating" name="rating" class="ss-form-control" required><option value="">Choose a rating...</option><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Average</option><option value="2">2 - Poor</option><option value="1">1 - Bad</option></select></div>
                    <div class="admin-form-field"><label for="reviewTitle">Title (optional)</label><input id="reviewTitle" name="title" class="ss-form-control" maxlength="120" /></div>
                    <div class="admin-form-field"><label for="reviewComment">Your review</label><textarea id="reviewComment" name="comment" class="ss-form-control" rows="4" maxlength="2000" required></textarea></div>
                    <button type="submit" class="ss-btn ss-btn-primary">Submit review</button>
                </form>
            </div>
        }
        else { <p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Products/Details/@Model.Id">Log in</a> to write a review.</p> }
    </section>
</div>
